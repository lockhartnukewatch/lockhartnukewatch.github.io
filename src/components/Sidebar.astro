---
// Persistent site sidebar: updates, FAQ topics, and archive entries.
// Fetches its own collections (Jekyll read site collections directly; this is
// the Astro equivalent) so any page can just drop in <Sidebar />.
// Items with external_url open in a new tab.
import { getCollection } from 'astro:content';

const updates = (await getCollection('updates')).sort((a, b) =>
  (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const topics = (await getCollection('topics')).sort((a, b) => a.id.localeCompare(b.id));
const archive = (await getCollection('archive')).sort((a, b) => a.id.localeCompare(b.id));

const groups = [
  {
    title: 'Updates',
    items: updates.map((e) => ({ title: e.data.title, url: `/updates/${e.id}/` })),
  },
  {
    title: 'FAQ Topics',
    items: topics.map((e) => ({
      title: e.data.title,
      url: `/topics/${e.id}/`,
      external_url: e.data.external_url,
    })),
  },
  {
    title: 'Archive',
    items: archive.map((e) => ({ title: e.data.title, url: `/archive/${e.id}/` })),
  },
];

// Normalize /index.html → / (dev uses /, preview serves /index.html).
const currentPath = Astro.url.pathname.replace(/index\.html$/, '');
---

{
  groups.map((group, i) => (
    <>
      <nav class="nav__items">
        <h3 class="nav__title">{group.title}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              {item.external_url ? (
                <a href={item.external_url} target="_blank" rel="noopener">
                  {item.title}
                </a>
              ) : (
                <a href={item.url} class:list={{ active: item.url === currentPath }}>
                  {item.title}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      {i < groups.length - 1 && <hr class="sidebar-rule" />}
    </>
  ))
}
