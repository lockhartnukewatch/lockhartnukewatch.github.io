---
// Base layout: <head> metadata, header (site title only), main (content +
// persistent sidebar), footer.
// Ported from the Jekyll era: site title/description from _config.yml,
// Facebook group link + contact email in the footer.
// All navigation lives in the sidebar (left on desktop, below content on
// mobile); the header is just the site title.
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Render the persistent sidebar (off only for 404). */
  sidebar?: boolean;
}

const SITE_TITLE = 'Lockhart Nuke Watch';
const SITE_DESCRIPTION =
  '"Lockhart Nuke Watch" was started to try and gather information about the Groves Isotope nuclear reactor being built in Lockhart, Texas by Oklo. Find us at on Facebook at https://www.facebook.com/groups/987252890512778.';
const FACEBOOK_URL = 'https://www.facebook.com/groups/987252890512778';
const CONTACT_EMAIL = 'contact@lockhartnuke.watch';

const { title, description = SITE_DESCRIPTION, sidebar = true } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-container">
        <a class="site-title" href="/">{SITE_TITLE}</a>
      </div>
    </header>

    <main class="site-main" role="main">
      {sidebar ? (
        <div class="page">
          <div class="page__content">
            <slot />
          </div>
          <aside class="page__sidebar">
            <Sidebar />
          </aside>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <footer class="site-footer">
      <div class="site-container">
      <p>
        <a href={FACEBOOK_URL} target="_blank" rel="noopener">
          Lockhart Nuke Watch on Facebook
        </a>
        {' '}
        &middot; <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
      </div>
    </footer>
  </body>
</html>
